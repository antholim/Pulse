# Copy to .env and fill in. Never commit .env or private keys.

# Discord (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=
# Right-click the server / channel with Developer Mode on > Copy ID
DISCORD_GUILD_ID=
REMINDERS_CHANNEL_ID=
# Optional, defaults to REMINDERS_CHANNEL_ID
PR_SUMMARY_CHANNEL_ID=

# GitHub repository the bot reads milestones and pull requests from
GITHUB_REPO=antholim/Pulse

# GitHub auth, option A: fine-grained personal access token
# (repository access: this repo; permissions: Issues read, Pull requests read)
GITHUB_TOKEN=

# GitHub auth, option B: GitHub App (leave GITHUB_TOKEN empty to use this)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Either the key itself (newlines as \n) or a path to the .pem file
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=

# Optional settings (defaults shown)
TIMEZONE=America/Toronto
# Daily open PR summary time, HH:MM in TIMEZONE. Leave empty to turn it off.
PR_SUMMARY_TIME=21:00
# Role to mention in the daily PR summary (optional, the role must be mentionable)
PR_SUMMARY_ROLE_ID=
# Deadline reminders are not posted before this hour
REMINDER_HOUR=9
DB_PATH=data/team-bot.db
# Release name = last iteration of that release
RELEASES=Release 1=4,Release 2=8,Final Release=13