
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=pulse_db

DATABASE_URL=postgresql+psycopg://pulse_user:your_local_password@localhost:5432/pulse_db

# Frontend origins allowed to call the API, comma-separated. Defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173

# Integration tests run only when this is set; uncomment it after
# `docker compose --profile test up -d test-db`
# TEST_DATABASE_URL=postgresql+psycopg://pulse_test:pulse_test@localhost:5433/pulse_test

# Backend log level: DEBUG, INFO, WARN or ERROR. Defaults to INFO.
# LOG_LEVEL=INFO

# Omerlo backoffice API (staging). The API key lives only in the team's private repo.
OMERLO_BASE_URL=https://staging.omerlo.app/api   # staging URL to confirm (#23)
OMERLO_API_KEY=your_api_key
